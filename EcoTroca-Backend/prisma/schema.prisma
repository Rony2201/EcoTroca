
enum ProductStatus {
  AVAILABLE
  RESERVED
  EXCHANGED
  INACTIVE
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}


model User {
  // Fields
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  username  String   @unique

 
  ownedProducts     Product[]    @relation("ProductOwner")
  lastOwnedProducts Product[]    @relation("ProductLastOwner")
  offers            TradeOffer[]
  messages          Message[]


  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  // Fields
  id       Int       @id @default(autoincrement())
  name     String    @unique

  // Relations
  products Product[]
}

model Product {
  // Fields
  id_product  Int         @id @default(autoincrement())
  title       String
  description String
  condition   String
  status      ProductStatus @default(AVAILABLE)
  imageUrl    String?
  city        String?
  district    String?
  address     String?


  owner       User?       @relation("ProductOwner", fields: [ownerId], references: [id])
  ownerId     Int?

  lastOwner   User?       @relation("ProductLastOwner", fields: [lastOwnerId], references: [id])
  lastOwnerId Int?

  category    Category?   @relation(fields: [categoryId], references: [id])
  categoryId  Int?

  offers      TradeOffer[]

 
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

 
  @@index([status, categoryId, city])
}

model TradeOffer {

  id          Int         @id @default(autoincrement())
  status      OfferStatus @default(PENDING)


  proposer    User        @relation(fields: [proposerId], references: [id])
  proposerId  Int

  product     Product     @relation(fields: [productId], references: [id_product])
  productId   Int

  messages    Message[]


  createdAt   DateTime    @default(now())


  @@unique([proposerId, productId])
}

model Message {

  id        Int      @id @default(autoincrement())
  content   String
  sentAt    DateTime @default(now())


  offer     TradeOffer @relation(fields: [offerId], references: [id])
  offerId   Int

  author    User     @relation(fields: [authorId], references: [id])
  authorId  Int
}


model Ownership {

  id        Int      @id @default(autoincrement())


  product   Product  @relation(fields: [productId], references: [id_product])
  productId Int

  user      User     @relation(fields: [userId], references: [id])
  userId    Int


  changedAt DateTime @default(now())


  @@index([productId, changedAt])
}